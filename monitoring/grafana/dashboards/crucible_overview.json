{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Throughput & Task Queue Health",
      "type": "row"
    },
    {
      "id": 1,
      "title": "Celery Broker Queue Depth",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "crucible_broker_queue_depth",
          "legendFormat": "Pending Tasks",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 85 },
              { "color": "orange", "value": 140 },
              { "color": "red", "value": 200 }
            ]
          },
          "unit": "short"
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "graphMode": "area",
        "colorMode": "background"
      }
    },
    {
      "id": 2,
      "title": "Total Batches Evaluated",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "targets": [
        {
          "expr": "crucible_batches_processed_total",
          "legendFormat": "Evaluated Batches",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "blue", "mode": "fixed" },
          "unit": "short"
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "graphMode": "none",
        "colorMode": "value"
      }
    },
    {
      "id": 3,
      "title": "Evaluation Rate (Batches / sec)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 1 },
      "targets": [
        {
          "expr": "rate(crucible_batches_processed_total[1m])",
          "legendFormat": "Ingestion Rate (1m window)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineInterpolation": "smooth",
            "fillOpacity": 15,
            "lineWidth": 2
          },
          "unit": "ops"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "id": 101,
      "title": "Inference Latency & SVD Profiling",
      "type": "row"
    },
    {
      "id": 4,
      "title": "1D-TCN Inference Latency Quantiles",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 14, "x": 0, "y": 7 },
      "targets": [
        {
          "expr": "crucible_worker_inference_latency_ms{quantile=\"0.5\"}",
          "legendFormat": "Median (p50)",
          "refId": "A"
        },
        {
          "expr": "crucible_worker_inference_latency_ms{quantile=\"0.95\"}",
          "legendFormat": "Tail (p95)",
          "refId": "B"
        },
        {
          "expr": "crucible_worker_inference_latency_ms{quantile=\"0.99\"}",
          "legendFormat": "Extreme Tail (p99)",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "unit": "ms"
        }
      }
    },
    {
      "id": 5,
      "title": "Latest Inference Latency Gauges",
      "type": "gauge",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 10, "x": 14, "y": 7 },
      "targets": [
        {
          "expr": "crucible_worker_inference_latency_ms{quantile=\"0.95\"}",
          "legendFormat": "p95 Latency",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 85 },
              { "color": "orange", "value": 140 },
              { "color": "red", "value": 200 }
            ]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "id": 102,
      "title": "Metallurgical Degradation Inferences",
      "type": "row"
    },
    {
      "id": 6,
      "title": "Failure Mode Distribution (Cumulative)",
      "type": "piechart",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 10, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "crucible_failure_mode_verdict_total",
          "legendFormat": "{{class}}",
          "refId": "A"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] },
        "pieType": "donut"
      }
    },
    {
      "id": 7,
      "title": "Failure Class Anomaly Event Timeline",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 14, "x": 10, "y": 16 },
      "targets": [
        {
          "expr": "increase(crucible_failure_mode_verdict_total[5m])",
          "legendFormat": "{{class}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": { "mode": "normal" }
          },
          "unit": "short"
        }
      }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["crucible", "1d-tcn", "metallurgy", "inference"],
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m"]
  },
  "timezone": "browser",
  "title": "Crucible Diagnostics: Industrial Engine Telemetry",
  "uid": "crucible-engine-telemetry",
